# Database
DATABASE_URL=mysql://user:password@localhost:3306/farmstock
# Optional: path to the CA bundle TiDB offers in its Connect dialog. Only needed
# if Node reports UNABLE_TO_VERIFY_LEAF_SIGNATURE / self-signed certificate.
DATABASE_CA_CERT=

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---------------------------------------------------------------------------
# SMS / OTP delivery
#
# Pick ONE provider. You can force a choice with SMS_PROVIDER, otherwise the
# first configured provider wins (Arkesel, mNotify, Africa's Talking, Twilio).
#
#   SMS_PROVIDER=arkesel | mnotify | africas_talking | twilio | console
#   SMS_SENDER_ID=FarmStock
#
# With nothing configured, development logs the code to the console and returns
# it in the API response; production refuses to issue a code.
# ---------------------------------------------------------------------------

# Arkesel (Ghana) — https://arkesel.com/developer-api/sms-api/
# Free signup credits; ~GH¢0.03 per SMS after that.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=FarmStock

# mNotify (Ghana) — https://apps.mnotify.net
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=FarmStock

# Africa's Talking — sandbox is free but only reaches the web simulator.
# Set AT_SANDBOX=true for the sandbox (username is literally "sandbox").
AT_API_KEY=
AT_USERNAME=
AT_SANDBOX=
AT_SENDER_ID=

# Twilio — trial credit only, then paid.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# WhatsApp Cloud API — NOT free. Meta bills each authentication template message
# (~$0.004 in Ghana, which is more than a local SMS). Requires a Meta Business
# account, a WhatsApp Business Account and an approved authentication template
# whose body takes one {{1}} parameter for the code.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=farmstock_otp
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_API_VERSION=v21.0

# Optional
PORT=3000
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# Optional analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
